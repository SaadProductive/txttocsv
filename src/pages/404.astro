---
import Base from '../layouts/Base.astro';
---
<Base title="Page Not Found | txttocsv" description="That page could not be found. Head back to the free TXT to CSV converter or browse the conversion guides." noindex={true}>
  <section class="section wrap center" style="max-width:620px">
    <p class="eyebrow">Error 404</p>
    <h1>This cell is empty</h1>
    <p class="lead">The page you were after does not exist or has moved.</p>
    <p style="margin-top:1.5rem">
      <a href="/" class="btn btn-primary">Go to the converter</a>
      <a href="/blog" class="btn btn-ghost" style="margin-left:.6rem">Browse guides</a>
    </p>
  </section>
</Base>
