---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.updated).getTime() - new Date(a.data.updated).getTime()
);
const fmt = (s: string) => new Date(s).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---
<Base
  title="TXT and CSV Conversion Guides | txttocsv"
  description="Practical, tested guides for converting between TXT and CSV in Excel, Python, PowerShell, Notepad++ and more, with fixes for the errors that break real files."
>
  <section class="section wrap" style="max-width:820px">
    <p class="eyebrow">Guides</p>
    <h1>TXT and CSV conversion guides</h1>
    <p class="lead">Tested methods and fixes for the errors that break real files. No filler.</p>

    <div class="post-list" style="margin-top:2rem">
      {posts.map((p) => (
        <a class="post-row" href={`/blog/${p.slug}`}>
          <h3>{p.data.title}</h3>
          <p>{p.data.description}</p>
          <div class="rowmeta">{p.data.intent} &middot; Updated {fmt(p.data.updated)}</div>
        </a>
      ))}
    </div>
  </section>
</Base>
